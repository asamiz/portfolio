---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getArticles, formatDate, readingTime, type Article } from '../../lib/articles';

export async function getStaticPaths() {
  const articles = await getArticles();
  return articles.map((article) => ({ params: { id: article.id }, props: { article } }));
}

const { article } = Astro.props as { article: Article };
const { Content } = await render(article);
const { title, description, week, date, sources } = article.data;
---

<Base title={`${title} — Ahmed Sami`} description={description} type="article">
  <nav><a href="/articles/">All articles</a></nav>

  <article>
    <header>
      <span>Week {week}</span>
      <time datetime={date.toISOString()}>{formatDate(date)}</time>
      <span>{readingTime(article.body)}</span>
      <h1>{title}</h1>
      <p>{description}</p>
    </header>

    <Content />

    {sources.length > 0 && (
      <section>
        <h2>Sources</h2>
        <ol>
          {sources.map((s) => <li><a href={s.url}>{s.title}</a></li>)}
        </ol>
      </section>
    )}
  </article>
</Base>
