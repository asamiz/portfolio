---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import avatar from '../assets/image.jpg';
import { profile, contacts, experience } from '../data/profile';
---

<Base title={`${profile.name} — ${profile.title}`} description={`${profile.title} in ${profile.location}. ${profile.intro}`}>
  <header>
    <Image src={avatar} alt={`Illustrated portrait of ${profile.name}`} width={192} />
    <h1>{profile.name}</h1>
    <p>{profile.title} in {profile.location}. {profile.intro}</p>
    <a href="/articles/">Read my articles</a>
    <ul>
      {contacts.map((c) => <li><a href={c.href}>{c.label}</a></li>)}
    </ul>
  </header>

  <section>
    <h2>Experience</h2>
    <ul>
      {experience.map((job) => (
        <li>
          <span>{job.dates}</span>
          <h3>{job.role} at {job.company}</h3>
          <p>{job.summary}</p>
        </li>
      ))}
    </ul>
  </section>
</Base>
