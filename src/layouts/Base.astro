---
import { avatarImageUrl } from '../lib/seo';
import { profile, footerLinks } from '../data/profile';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  type?: 'website' | 'article';
  /** Article publish date, for link previews and search engines. */
  publishedTime?: Date;
  /** Hide the page from search engines (used by the 404 page). */
  noindex?: boolean;
  /** Structured data (schema.org) that helps Google understand the page. */
  jsonLd?: Record<string, unknown>;
}

const { title, description, type = 'website', publishedTime, noindex = false, jsonLd } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = await avatarImageUrl(Astro.site!);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#faf9f6" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#16181d" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="author" content={profile.name} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title={`${profile.name} — Articles`} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="600" />
    <meta property="og:image:height" content="600" />
    <meta property="og:image:alt" content={`Illustrated portrait of ${profile.name}`} />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    <meta name="twitter:card" content="summary" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,400..600;1,8..60,400..600&family=Geist+Mono:wght@400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="page">
      <div class="container">
        <header class="site-header">
          <a class="home" href="/">{profile.name}</a>
          <a class="nav" href="/articles/">Articles</a>
        </header>

        <main class="site-main">
          <slot />
        </main>

        <footer class="site-footer">
          {footerLinks.map((l) => (
            <>
              <a href={l.href}>{l.label}</a>
              <span aria-hidden="true">·</span>
            </>
          ))}
          <span>© {new Date().getFullYear()}</span>
        </footer>
      </div>
    </div>
  </body>
</html>
