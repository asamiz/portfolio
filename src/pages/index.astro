---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import avatar from '../assets/image.jpg';
import { profile, introLinks } from '../data/profile';
import { getArticles, formatDate } from '../lib/articles';
import { person } from '../lib/seo';

const latest = (await getArticles()).slice(0, 3);
const site = Astro.site!;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', name: profile.name, url: site.href },
    { '@type': 'ProfilePage', url: site.href, mainEntity: await person(site) },
  ],
};
---

<Base title={`${profile.name} — ${profile.title}`} description={`${profile.title}. ${profile.tagline}`} jsonLd={jsonLd}>
  <div class="home">
    <section class="intro">
      <Image src={avatar} alt={profile.name} width={192} class="avatar" loading="eager" />
      <div class="intro-text">
        <h1 class="page-title">{profile.name}</h1>
        <p class="muted">{profile.title}</p>
        <p>{profile.tagline}</p>
      </div>
      <nav class="intro-links" aria-label="Contact">
        {introLinks.map((l) => <a class="link" href={l.href}>{l.label}</a>)}
      </nav>
    </section>

    <section class="latest">
      <h2>Latest articles</h2>
      {latest.length === 0 ? (
        <p class="muted">The first article is on its way.</p>
      ) : (
        <div>
          {latest.map((a) => (
            <a class="row" href={`/articles/${a.id}/`}>
              <span>{a.data.title}</span>
              <span class="mono">{formatDate(a.data.date)}</span>
            </a>
          ))}
        </div>
      )}
      <a class="link all" href="/articles/">All articles →</a>
    </section>
  </div>
</Base>

<style>
  .home { display: flex; flex-direction: column; gap: 72px; }
  .intro { display: flex; flex-direction: column; gap: 24px; }
  .avatar {
    display: block;
    width: 96px;
    height: 96px;
    border-radius: 50%;
    object-fit: cover;
    object-position: center 25%;
    background: var(--surface);
  }
  .intro-text { display: flex; flex-direction: column; gap: 8px; }
  .intro-text p { margin: 0; }
  .intro-links { display: flex; flex-wrap: wrap; gap: 8px 24px; }

  .latest { display: flex; flex-direction: column; gap: 12px; }
  .latest h2 { margin: 0; font-size: 22px; line-height: 1.3; font-weight: 600; }
  .latest p { margin: 0; }
  .latest .row { padding: 10px 0; }
  .all { align-self: flex-start; }

  @media (max-width: 640px) {
    .home { gap: 56px; }
  }
</style>
