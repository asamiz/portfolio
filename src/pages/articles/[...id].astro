---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getArticles, formatDate, readingTime, type Article } from '../../lib/articles';
import { person } from '../../lib/seo';

export async function getStaticPaths() {
  const articles = await getArticles();
  return articles.map((article) => ({ params: { id: article.id }, props: { article } }));
}

const { article } = Astro.props as { article: Article };
const { Content } = await render(article);
const { title, description, date, sources } = article.data;

const site = Astro.site!;
const url = new URL(Astro.url.pathname, site).href;
const author = await person(site);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: date.toISOString(),
  url,
  mainEntityOfPage: url,
  image: author.image,
  author,
};
---

<Base title={`${title} — Ahmed Sami`} description={description} type="article" publishedTime={date} jsonLd={jsonLd}>
  <a class="link back" href="/articles/">← All articles</a>
  <h1 class="page-title title">{title}</h1>
  <div class="meta mono">
    <time datetime={date.toISOString()}>{formatDate(date)}</time>
    <span aria-hidden="true">·</span>
    <span>{readingTime(article.body)}</span>
  </div>

  <article class="prose">
    <Content />

    {sources.length > 0 && (
      <>
        <h2>Sources</h2>
        <ol>
          {sources.map((s) => <li><a href={s.url}>{s.title}</a></li>)}
        </ol>
      </>
    )}
  </article>
</Base>

<style>
  .back { font-size: 16px; align-self: flex-start; }
  .title { margin: 24px 0 8px; text-wrap: balance; }
  .meta { display: flex; gap: 8px; }

  .prose { margin-top: 40px; text-wrap: pretty; }
  .prose :global(p) { margin: 0 0 20px; }
  .prose :global(h2) { margin: 40px 0 12px; font-size: 22px; line-height: 1.3; font-weight: 600; }
  .prose :global(h3) { margin: 32px 0 8px; font-size: 18px; line-height: 1.4; font-weight: 600; }
  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 20px;
    padding-left: 22px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .prose :global(a) {
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--muted);
    text-underline-offset: 3px;
  }
  .prose :global(a:hover) { text-decoration-color: var(--text); }
  .prose :global(blockquote) {
    margin: 0 0 20px;
    padding: 2px 0 2px 20px;
    border-left: 2px solid var(--border);
    color: var(--muted);
  }
  .prose :global(blockquote p) { margin: 0; }
  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 15px;
    background: var(--surface);
    padding: 2px 6px;
    border-radius: 4px;
    color: var(--text);
  }
  .prose :global(pre) {
    margin: 0 0 20px;
    padding: 16px 20px;
    background: var(--surface);
    border-radius: 8px;
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 14px;
    line-height: 1.6;
    white-space: pre;
  }
  .prose :global(pre code) { padding: 0; background: none; font-size: inherit; border-radius: 0; }
  .prose :global(img) { max-width: 100%; height: auto; border-radius: 8px; }
  .prose :global(hr) { border: 0; border-top: 1px solid var(--border); margin: 40px 0; }
  .prose > :global(:last-child) { margin-bottom: 0; }
</style>
