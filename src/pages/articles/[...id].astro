---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getArticles, formatDate, readingTime, type Article } from '../../lib/articles';

export async function getStaticPaths() {
  const articles = await getArticles();
  return articles.map((article) => ({ params: { id: article.id }, props: { article } }));
}

const { article } = Astro.props as { article: Article };
const { Content } = await render(article);
const { title, description, week, date, sources } = article.data;
---

<Base title={`${title} — Ahmed Sami`} description={description} type="article">
  <nav class="top-nav" aria-label="Site">
    <a href="/">Ahmed Sami</a>
    <a href="/articles/">All articles</a>
  </nav>

  <article>
    <header>
      <p class="meta">
        <span>Week {week}</span>
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        <span>{readingTime(article.body)}</span>
      </p>
      <h1>{title}</h1>
      <p class="question">{description}</p>
    </header>

    <div class="prose">
      <Content />
    </div>

    {sources.length > 0 && (
      <section class="sources" aria-labelledby="sources">
        <h2 id="sources">Sources</h2>
        <ol>
          {sources.map((s) => (
            <li><a class="text-link" href={s.url}>{s.title}</a></li>
          ))}
        </ol>
      </section>
    )}
  </article>
</Base>

<style>
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    margin: 0 0 1rem;
    font-size: 0.95rem;
    color: var(--muted);
  }
  h1 {
    margin: 0;
    font-size: clamp(2.25rem, 7vw, 3.5rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }
  .question { margin: 1rem 0 0; font-size: 1.25rem; color: var(--muted); }

  .prose { margin-top: 2.5rem; font-size: 1.125rem; line-height: 1.7; }
  .prose :global(h2) { margin: 2.5rem 0 0.75rem; font-size: 1.5rem; font-weight: 700; line-height: 1.25; letter-spacing: -0.01em; }
  .prose :global(h3) { margin: 2rem 0 0.5rem; font-size: 1.2rem; font-weight: 500; }
  .prose :global(p), .prose :global(ul), .prose :global(ol) { margin: 0 0 1.25rem; }
  .prose :global(li) { margin-bottom: 0.4rem; }
  .prose :global(a) {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 3px;
  }
  .prose :global(blockquote) {
    margin: 1.5rem 0;
    padding-left: 1.25rem;
    border-left: 3px solid var(--accent);
    color: var(--muted);
  }
  .prose :global(code) {
    font-size: 0.9em;
    padding: 0.1em 0.35em;
    border-radius: 4px;
    background: var(--code-bg);
  }
  .prose :global(pre) {
    margin: 1.5rem 0;
    padding: 1rem 1.25rem;
    border-radius: 8px;
    overflow-x: auto;
    font-size: 0.9rem;
    line-height: 1.55;
  }
  .prose :global(pre code) { padding: 0; background: none; }
  .prose :global(img) { max-width: 100%; height: auto; border-radius: 8px; }
  .prose :global(hr) { border: 0; border-top: 1px solid var(--rule); margin: 2.5rem 0; }

  .sources { margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--rule); }
  .sources h2 { margin: 0 0 0.75rem; font-size: 1.1rem; font-weight: 500; }
  .sources ol { margin: 0; padding-left: 1.25rem; color: var(--muted); }
  .sources li { margin-bottom: 0.4rem; }
  .sources a { color: var(--ink); }
</style>
