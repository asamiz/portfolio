---
import Base from '../../layouts/Base.astro';
import { getArticles, formatDate, readingTime } from '../../lib/articles';

const articles = await getArticles();
---

<Base title="Articles — Ahmed Sami" description="Every week I study a topic I don't know yet and write what I learned.">
  <nav><a href="/">Ahmed Sami</a></nav>

  <h1>Articles</h1>

  {articles.length === 0 ? (
    <p>The first article is on its way.</p>
  ) : (
    <ul>
      {articles.map((a) => (
        <li>
          <span>Week {a.data.week}</span>
          <a href={`/articles/${a.id}/`}>{a.data.title}</a>
          {a.data.draft && <span>Draft</span>}
          <p>{a.data.description}</p>
          <time datetime={a.data.date.toISOString()}>{formatDate(a.data.date)}</time>
          <span>{readingTime(a.body)}</span>
        </li>
      ))}
    </ul>
  )}
</Base>
